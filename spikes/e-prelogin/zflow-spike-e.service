[Unit]
Description=zflow spike E: pre-login uinput injection test
# Hold the display manager until the injector creates and classifies its
# keyboard. The process sends READY=1 before it waits for the greeter.
Before=display-manager.service
Wants=systemd-udevd.service
After=systemd-udevd.service

[Service]
Type=notify
NotifyAccess=all
# absolute path is filled in by install.sh
ExecStart=__BINARY__ --log /var/log/zflow-spike-e.log --greeter-timeout 30 --settle-ms 5000
TimeoutStartSec=15
Restart=no

[Install]
WantedBy=multi-user.target
