<Window
    x:Class="Zflow.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="zflow">
  <Grid x:Name="Root">
    <Grid.Resources>
      <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="16,0">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/zflow.png" Width="20" Height="20" />
        <TextBlock Text="zflow" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False"
                    IsBackButtonVisible="Collapsed" AlwaysShowHeader="False"
                    PaneDisplayMode="Auto" OpenPaneLength="228"
                    CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="900"
                    SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ComputersNav" Content="Computers" Tag="computers">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Settings" Tag="settings">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="About zflow" Tag="about">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
        <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PageContent" Padding="32,28,32,32" Spacing="28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock x:Name="PageTitle" Text="Computers" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar x:Name="MessageBar" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Warning" />
            <StackPanel x:Name="ComputersPage" Spacing="28">
              <controls:SettingsCard Header="Input sharing">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE962;" /></controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Description>
                  <TextBlock x:Name="ConnectionSummary" Text="Starting…" TextWrapping="Wrap" />
                </controls:SettingsCard.Description>
                <ToggleSwitch x:Name="SharingSwitch" AutomationProperties.Name="Input sharing" Toggled="Sharing_Toggled" IsEnabled="False" />
              </controls:SettingsCard>
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Screen arrangement" Style="{StaticResource SectionHeading}" />
                  <TextBlock Text="Arrange individual monitors. Drag their edges together to switch computers." Style="{StaticResource SecondaryText}" />
                </StackPanel>
                <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <Canvas x:Name="Arrangement" Height="240" SizeChanged="Arrangement_SizeChanged" Background="Transparent" />
                </Border>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LocalName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LocalMark" Style="{StaticResource SecondaryText}" FontSize="12" IsTextSelectionEnabled="True" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Return here" Click="Local_Click" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Return input to this PC. Ctrl + Win + Backspace also pauses sharing." />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="8">
                <Grid Margin="0,0,0,4">
                  <TextBlock Text="Your computers" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                  <Button Content="Add computer" HorizontalAlignment="Right" Click="AddAddress_Click" />
                </Grid>
                <StackPanel x:Name="PeersPanel" Spacing="4" />
              </StackPanel>
              <StackPanel x:Name="NearbySection" Spacing="8">
                <TextBlock Text="Nearby computers" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Compare the marks before adding. Add this PC on the other computer too." Style="{StaticResource SecondaryText}" />
                <StackPanel x:Name="NearbyPanel" Spacing="4" />
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="28">
              <StackPanel Spacing="4">
                <TextBlock Text="General" Style="{StaticResource SectionHeading}" />
                <controls:SettingsCard Header="Run at startup" Description="Start zflow when you sign in to Windows.">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7B8;" /></controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch x:Name="StartupSwitch" AutomationProperties.Name="Run at startup" Toggled="Startup_Toggled" />
                </controls:SettingsCard>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Input and clipboard" Style="{StaticResource SectionHeading}" />
                <controls:SettingsCard Header="Pause at screen edges" Description="Wait briefly at an edge before switching computers.">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch x:Name="PauseEdgesSwitch" AutomationProperties.Name="Pause at screen edges" Toggled="PauseEdges_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="Share clipboard" Description="Copy text and PNG images between computers. Enable on both sides.">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77F;" /></controls:SettingsCard.HeaderIcon>
                  <ToggleSwitch x:Name="ClipboardSwitch" AutomationProperties.Name="Share clipboard" Toggled="Clipboard_Toggled" />
                </controls:SettingsCard>
                <controls:SettingsExpander Header="Keyboard shortcuts" Description="Switch computers or bring input back here.">
                  <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE765;" /></controls:SettingsExpander.HeaderIcon>
                  <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Return here and pause sharing"><TextBlock Text="Ctrl + Win + Backspace" /></controls:SettingsCard>
                    <controls:SettingsCard Header="Control a connected computer"><TextBlock Text="Ctrl + Win + F12" /></controls:SettingsCard>
                  </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Advanced" Style="{StaticResource SectionHeading}" />
                <controls:SettingsExpander Header="Connection and troubleshooting" Description="Network addresses, configuration, and engine controls.">
                  <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE9CE;" /></controls:SettingsExpander.HeaderIcon>
                  <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Network addresses" ContentAlignment="Vertical" HorizontalContentAlignment="Left">
                      <TextBlock x:Name="NetworkDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryText}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="Configuration" Description="Open your local settings file."><Button Content="Open file" Click="OpenConfig_Click" /></controls:SettingsCard>
                    <controls:SettingsCard Header="Input engine" Description="Restart after editing the configuration."><Button Content="Restart" Click="Restart_Click" /></controls:SettingsCard>
                    <controls:SettingsCard Header="Quit zflow" Description="Stop sharing and close the app."><Button Content="Quit" Click="Quit_Click" /></controls:SettingsCard>
                  </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="28">
              <Grid ColumnSpacing="20" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/zflow.png" Width="72" Height="72" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="One keyboard and pointer across your computers." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="zflow connects Windows, macOS, and Linux over your local network or Tailscale." Style="{StaticResource SecondaryText}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="4">
                <TextBlock Text="About" Style="{StaticResource SectionHeading}" />
                <controls:SettingsCard Header="Version" Description="Windows preview">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsCard.HeaderIcon>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" />
                    <HyperlinkButton Content="Release notes" NavigateUri="https://github.com/demfabris/zflow/blob/main/packaging/RELEASE_NOTES.md" />
                  </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Open source" Description="GNU General Public License v3.0 or later">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></controls:SettingsCard.HeaderIcon>
                  <HyperlinkButton Content="View license" NavigateUri="https://github.com/demfabris/zflow/blob/main/LICENSE" />
                </controls:SettingsCard>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Help and feedback" Style="{StaticResource SectionHeading}" />
                <controls:SettingsCard Header="Documentation" Description="Setup, pairing, and keyboard shortcuts." IsClickEnabled="True" Tag="https://github.com/demfabris/zflow/blob/main/windows/README.md" Click="OpenLink_Click">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></controls:SettingsCard.HeaderIcon>
                  <controls:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="GitHub repository" Description="Explore the code and contribute." IsClickEnabled="True" Tag="https://github.com/demfabris/zflow" Click="OpenLink_Click">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE943;" /></controls:SettingsCard.HeaderIcon>
                  <controls:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
                <controls:SettingsCard Header="Report a bug or request a feature" IsClickEnabled="True" Tag="https://github.com/demfabris/zflow/issues/new" Click="OpenLink_Click">
                  <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE939;" /></controls:SettingsCard.HeaderIcon>
                  <controls:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></controls:SettingsCard.ActionIcon>
                </controls:SettingsCard>
              </StackPanel>
              <TextBlock Text="Made by the zflow contributors." Style="{StaticResource SecondaryText}" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </NavigationView>
  </Grid>
</Window>
