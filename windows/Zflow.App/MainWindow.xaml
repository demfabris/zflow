<Window x:Class="Zflow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="zflow">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="20,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8AB;" FontSize="16"/><TextBlock Text="zflow" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Padding="12,20,12,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
          <Button x:Name="ComputersNav" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Computers_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="17"/><TextBlock Text="Computers"/></StackPanel></Button>
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Text="Settings"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10" Margin="10,0"><TextBlock Text="ONE KEYBOARD. EVERY SCREEN." FontSize="9" Opacity="0.55" TextWrapping="Wrap"/><TextBlock x:Name="LocalName" Text="This computer" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="LocalMark" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
      </Grid>
      <Border Grid.Column="1" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <ScrollViewer x:Name="PageScroll"><StackPanel Padding="32,28,32,32" Spacing="22">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock x:Name="PageTitle" Text="Computers" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="ConnectionSummary" Text="Starting input engine…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ToggleSwitch x:Name="SharingSwitch" Grid.Column="1" Header="Sharing" Toggled="Sharing_Toggled" IsEnabled="False" Margin="20,0,0,0"/></Grid>
          <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Severity="Warning" Title="Check connection"/>
          <StackPanel x:Name="ComputersPage" Spacing="22">
            <StackPanel Spacing="10"><TextBlock Text="Your screens" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Drag a computer until its edge touches another. Move your pointer across that edge to switch." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><Canvas x:Name="Arrangement" Height="260" SizeChanged="Arrangement_SizeChanged" Background="Transparent"/></Border>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Return input here" Click="Local_Click"/><TextBlock Text="Ctrl + Win + Backspace returns and pauses sharing" VerticalAlignment="Center" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/></StackPanel>
            </StackPanel>
            <StackPanel Spacing="12"><Grid><TextBlock Text="Added computers" FontSize="18" FontWeight="SemiBold"/><Button Content="Add by address" HorizontalAlignment="Right" Click="AddAddress_Click"/></Grid><StackPanel x:Name="PeersPanel" Spacing="8"/></StackPanel>
            <StackPanel Spacing="12"><TextBlock Text="Found on your network" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Compare the marks on both computers, then add each computer on the other one too." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel x:Name="NearbyPanel" Spacing="8"/></StackPanel>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="22">
            <StackPanel Spacing="12"><TextBlock Text="Windows" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="StartupSwitch" Header="Start at login" Toggled="Startup_Toggled"/><TextBlock Text="Closing the window keeps zflow in the notification area. Open it there to resume, arrange screens, or quit." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <StackPanel Spacing="10"><TextBlock Text="Keyboard and pointer" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch x:Name="PauseEdgesSwitch" Header="Pause at edges" Toggled="PauseEdges_Toggled"/><TextBlock Text="Ctrl + Win + F12 switches to a connected computer. Ctrl + Win + Backspace always returns input and pauses sharing." TextWrapping="Wrap"/><TextBlock Text="Input sharing works in your unlocked desktop. Windows sign-in, UAC prompts, and elevated apps are not controlled by the normal app." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <StackPanel Spacing="8"><ToggleSwitch x:Name="ClipboardSwitch" Header="Share clipboard" Toggled="Clipboard_Toggled"/><TextBlock Text="Text and PNG images up to 3 MB go with the pointer. Turn this on on both computers." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <StackPanel Spacing="10"><TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NetworkDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="For Tailscale, use Add by address with the other computer’s name or IP. Allow the zflow engine through Windows Firewall when Windows asks." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open configuration" Click="OpenConfig_Click"/><Button Content="Restart engine" Click="Restart_Click"/><Button Content="Quit zflow" Click="Quit_Click"/></StackPanel>
            <TextBlock Text="zflow · Windows preview" FontSize="12" Opacity="0.6"/>
          </StackPanel>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
